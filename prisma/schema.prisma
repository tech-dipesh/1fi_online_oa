generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  brand       String
  description String
  createdAt   DateTime         @default(now())
  variants    ProductVariant[]
  emiRules    EmiRule[]
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label       String
  storage     String?
  color       String?
  mrp         Int
  price       Int
  imageUrl    String
  createdAt   DateTime    @default(now())
  selections  Selection[]

  @@unique([productId, label])
}

model EmiRule {
  id              String   @id @default(cuid())
  minPrice        Int
  maxPrice        Int
  tenureMonths    Int
  interestRate    Float
  cashbackPercent Float
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([minPrice, maxPrice])
}

model Selection {
  id             String         @id @default(cuid())
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tenureMonths   Int
  interestRate   Float
  monthlyAmount  Int
  cashbackAmount Int
  totalPayable   Int
  createdAt      DateTime       @default(now())
}